# Port the BFF server listens on
PORT=9001

# Full URL of the handläggare list endpoint on the handläggning backend
HANDLAGGARE_URL=https://handlaggning.internal.example.com/handlaggare

# Base URL of the OUL service
BE_OUL_URL=https://oul.internal.example.com

# Optional: path to the micro-frontend registry JSON file.
# Defaults to remotes.json next to the server entrypoint.
# In Kubernetes, mount a ConfigMap as a file and set this to the mount path —
# updating the ConfigMap then updates the registry with zero rebuilds.
# REMOTES_CONFIG_PATH=/etc/config/remotes.json
